// Cloudflare Workers static-assets config. Workers Builds runs `npx wrangler deploy` on push to main.
{
  "name": "isc2arkansas",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "site",
    // Serve site/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page"
  },
  // Served on isc2arkansas.org and www via Worker Custom Domains (attached 2026-09-25).
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
